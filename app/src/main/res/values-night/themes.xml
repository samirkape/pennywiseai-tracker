<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base dark theme -->
    <style name="Theme.Spendlycompose" parent="android:Theme.Material.NoActionBar" />
    
    <!-- Splash Screen theme for dark mode -->
    <style name="Theme.Spendly.SplashScreen" parent="Theme.SplashScreen">
        <!-- Spendly brand dark indigo for dark mode -->
        <item name="windowSplashScreenBackground">#1E1B4B</item>
        
        <!-- Use the app icon as splash icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        
        <!-- Set splash screen duration (Android 12+) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        
        <!-- Set the theme to use after splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.Spendlycompose</item>
    </style>
</resources>
