<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme -->
    <style name="Theme.Pennywisecompose" parent="android:Theme.Material.Light.NoActionBar" />
    
    <!-- Splash Screen theme for light mode -->
    <style name="Theme.PennyWise.SplashScreen" parent="Theme.SplashScreen">
        <!-- Spendly brand violet, matches icon background -->
        <item name="windowSplashScreenBackground">#5B21B6</item>
        
        <!-- Use the app icon as splash icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        
        <!-- Set splash screen duration (Android 12+) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        
        <!-- Set the theme to use after splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.Pennywisecompose</item>
    </style>
</resources>
