<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room database (main file + WAL journal) -->
        <include domain="database" path="pennywise_database"/>
        <include domain="database" path="pennywise_database-wal"/>
        <include domain="database" path="pennywise_database-shm"/>
        <!-- User preferences -->
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Room database (main file + WAL journal) -->
        <include domain="database" path="pennywise_database"/>
        <include domain="database" path="pennywise_database-wal"/>
        <include domain="database" path="pennywise_database-shm"/>
        <!-- User preferences -->
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
