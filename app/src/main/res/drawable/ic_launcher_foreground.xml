<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Spendly icon — rising bar chart + trend line + coin at peak
        Safe zone: 18–90 on each axis. Bars centered in x 27–81.
        Visual language: "your spending, tracked and growing smart"
    -->

    <!-- Ground baseline -->
    <path
        android:pathData="M 20,85.5 L 88,85.5"
        android:fillColor="#00000000"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Bar 1 (shortest) — slightly translucent, rounded top corners only -->
    <path
        android:pathData="M 27,85 L 27,79 Q 27,74 32,74 L 36,74 Q 41,74 41,79 L 41,85 Z"
        android:fillColor="#AAFFFFFF" />

    <!-- Bar 2 (medium) — rounded top corners -->
    <path
        android:pathData="M 47,85 L 47,63 Q 47,58 52,58 L 56,58 Q 61,58 61,63 L 61,85 Z"
        android:fillColor="#CCFFFFFF" />

    <!-- Bar 3 (tallest) — solid white, primary focus -->
    <path
        android:pathData="M 67,85 L 67,43 Q 67,38 72,38 L 76,38 Q 81,38 81,43 L 81,85 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Rising trend line connecting top-centers of bars, ends at coin -->
    <path
        android:pathData="M 34,74 C 44,74 46,58 54,58 C 62,58 64,28 74,28"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Glow halo around peak coin -->
    <path
        android:pathData="M 63,28 A 11,11 0 1,0 85,28 A 11,11 0 1,0 63,28 Z"
        android:fillColor="#40FFFFFF" />

    <!-- Coin at trend peak (solid white circle) -->
    <path
        android:pathData="M 67,28 A 7,7 0 1,0 81,28 A 7,7 0 1,0 67,28 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Small up-chevron above the coin to signal "upward" momentum -->
    <path
        android:pathData="M 70,19 L 74,15 L 78,19"
        android:fillColor="#00000000"
        android:strokeColor="#CCFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Tiny sparkle dot top-left (visual balance) -->
    <path
        android:pathData="M 26,26 A 2.5,2.5 0 1,0 31,26 A 2.5,2.5 0 1,0 26,26 Z"
        android:fillColor="#66FFFFFF" />

    <!-- Tiny sparkle cross top-left -->
    <path
        android:pathData="M 28.5,22 L 28.5,30 M 24.5,26 L 32.5,26"
        android:fillColor="#00000000"
        android:strokeColor="#44FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
