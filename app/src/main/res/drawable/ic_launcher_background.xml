<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep violet-to-blue gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#5B21B6" android:offset="0.0" />
                <item android:color="#1D4ED8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle glass-shine radial highlight in top-right -->
    <path android:pathData="M 108,0 A 60,60 0 0 1 108,60 L 108,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="108"
                android:centerY="0"
                android:gradientRadius="60"
                android:type="radial">
                <item android:color="#25FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle bottom-left dark vignette for depth -->
    <path android:pathData="M 0,108 A 50,50 0 0 1 50,108 L 0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="0"
                android:centerY="108"
                android:gradientRadius="50"
                android:type="radial">
                <item android:color="#20000000" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
