+        // Load budget progress for hero card
+        launch {
+            budgetRepository.getCurrentBudgets()
+                .flatMapLatest { budgets ->
+                    val budget = budgets.firstOrNull { it.includeAllCategories } ?: budgets.firstOrNull()
+                    if (budget == null) {
+                        flowOf(null)
+                    } else {
+                        budgetRepository.getBudgetSpending(budget).map { spending -> budget to spending }
+                    }
+                }
+                .collect { pair ->
+                    if (pair == null) {
+                        _uiState.value = _uiState.value.copy(hasBudget = false)
+                    } else {
+                        val (budget, spending) = pair
+                        val isOver = spending.remaining < BigDecimal.ZERO
+                        _uiState.value = _uiState.value.copy(
+                            hasBudget = true,
+                            monthBudgetLimit = budget.limitAmount,
+                            monthBudgetRemaining = spending.remaining,
+                            overBudgetCategory = if (isOver) budget.name else null,
+                            overBudgetSpent = spending.totalSpent,
+                            overBudgetLimit = budget.limitAmount,
+                        )
+                    }
+                }
+        }
+
+        // Load upcoming subscription (nearest renewing within 7 days)
+        launch {
+            subscriptionRepository.getUpcomingSubscriptions(7).collect { upcoming ->
+                val today = LocalDate.now()
+                val nearest = upcoming
+                    .filter { it.nextPaymentDate != null && !it.nextPaymentDate!!.isBefore(today) }
+                    .minByOrNull { it.nextPaymentDate!! }
+                val daysAway = nearest?.nextPaymentDate?.let {
+                    java.time.temporal.ChronoUnit.DAYS.between(today, it).toInt().coerceAtLeast(0)
+                } ?: 0
+                _uiState.value = _uiState.value.copy(
+                    upcomingSubscription = nearest,
+                    upcomingSubscriptionDaysAway = daysAway,
+                )
+            }
+        }
+
+        // Load weekly spend bar chart data and nudge insight
+        launch {
+            val monday = now.with(java.time.temporal.TemporalAdjusters.previousOrSame(java.time.DayOfWeek.MONDAY))
+            val lastMonday = monday.minusWeeks(1)
+            val lastSunday = monday.minusDays(1)
+            combine(
+                dailySpendingTotalsFlow(monday, now),
+                dailySpendingTotalsFlow(lastMonday, lastSunday),
+            ) { thisWeek, lastWeek -> thisWeek to lastWeek }
+                .collect { (thisWeek, lastWeek) ->
+                    val weekTotal = thisWeek.values.fold(BigDecimal.ZERO) { a, b -> a + b }
+                    val lastWeekTotal = lastWeek.values.fold(BigDecimal.ZERO) { a, b -> a + b }
+                    val delta = if (lastWeekTotal > BigDecimal.ZERO) {
+                        ((weekTotal - lastWeekTotal).toDouble() / lastWeekTotal.toDouble() * 100).toInt()
+                    } else 0
+                    val barData = (0..6).map { i ->
+                        val day = monday.plusDays(i.toLong())
+                        if (!day.isAfter(now)) thisWeek[day] ?: BigDecimal.ZERO else BigDecimal.ZERO
+                    }
+                    val daysLeftInMonth = now.lengthOfMonth() - now.dayOfMonth
+                    val nudge: String? = when {
+                        delta > 30 -> "Your spending this week is $delta% higher than last week. $daysLeftInMonth days remain in the month."
+                        delta > 15 -> "You're trending higher than last week. Consider reviewing recent expenses."
+                        else -> null
+                    }
+                    _uiState.value = _uiState.value.copy(
+                        weeklySpendTotal = weekTotal,
+                        weeklySpendDeltaPercent = delta,
+                        weeklyBarData = barData,
+                        nudgeInsight = nudge,
+                    )
+                }
+        }
         } // end dataLoadingJob
     }
     
