+    /**
+     * Import loans with merge semantics.
+     * Returns a map of old loan ID -> new loan ID for transaction ID remapping.
+     */
+    private suspend fun importLoansWithMerge(loans: List<LoanEntity>): Map<Long, Long> {
+        val oldToNewIdMap = mutableMapOf<Long, Long>()
+        val existingLoans = database.loanDao().getAllLoans().first()
+        // Merge key: person_name + direction (case-insensitive)
+        val existingKeys = existingLoans.associateBy { "${it.personName.lowercase()}_${it.direction}" }
+
+        loans.forEach { loan ->
+            val key = "${loan.personName.lowercase()}_${loan.direction}"
+            val existing = existingKeys[key]
+            if (existing != null) {
+                // Map old ID -> existing local ID so transaction references stay valid
+                oldToNewIdMap[loan.id] = existing.id
+            } else {
+                val newId = database.loanDao().insertLoan(loan.copy(id = 0))
+                oldToNewIdMap[loan.id] = newId
+            }
+        }
+        return oldToNewIdMap
+    }
+
+    /**
+     * Import transaction groups with merge semantics.
+     * Returns a map of old group ID -> new group ID for transaction ID remapping.
+     */
+    private suspend fun importGroupsWithMerge(groups: List<TransactionGroupEntity>): Map<Long, Long> {
+        val oldToNewIdMap = mutableMapOf<Long, Long>()
+        val existingGroups = database.transactionGroupDao().getAllGroups().first()
+        val existingByName = existingGroups.associateBy { it.name.lowercase() }
+
+        groups.forEach { group ->
+            val existing = existingByName[group.name.lowercase()]
+            if (existing != null) {
+                oldToNewIdMap[group.id] = existing.id
+            } else {
+                val newId = database.transactionGroupDao().insertGroup(group.copy(id = 0))
+                oldToNewIdMap[group.id] = newId
+            }
+        }
+        return oldToNewIdMap
+    }
+
